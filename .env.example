APP_OWNER_EMAIL=
# Stable server-only PostgreSQL owner key. Generate it once per installation
# with scripts/ensure-app-owner-id.mjs; do not expose it as a NEXT_PUBLIC
# variable or change it after data is written.
APP_OWNER_ID=
AUTH_SECRET=
# Set to 1 temporarily to diagnose rejected same-origin requests. This logs
# request metadata only; it never logs cookies, tokens, passwords, or secrets.
AUTH_DEBUG=0
NEXT_PUBLIC_SITE_URL=https://homelab.tail861ffd.ts.net
# Local Compose deployment values. Set POSTGRES_PASSWORD to a new random value
# before starting the stack; the default in compose.yaml is only a validation
# placeholder. Keep the database port private and leave the storage path fixed.
POSTGRES_DB=wowzerbowser
POSTGRES_USER=wowzerbowser
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://wowzerbowser:replace-with-a-long-random-password@postgres:5432/wowzerbowser
WEB_PORT=3000
APP_UID=1000
APP_GID=1000
WORKER_CHAT_CONCURRENCY=1
WORKER_DOCUMENT_CONCURRENCY=1
WORKER_IMAGE_CONCURRENCY=1
WORKER_OCR_CONCURRENCY=2
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_MAX_AGE_MS=30000
# Background-worker sweep for automations, memory recovery, and bounded maintenance.
STORAGE_MAINTENANCE_INTERVAL_MS=60000
# Optional secret for the legacy manually-triggered internal dispatch route.
# The background-worker scheduler is local and PostgreSQL-backed.
AUTOMATION_DISPATCH_SECRET=replace-with-at-least-32-random-characters
AUTOMATION_SCHEDULER_INTERVAL_MS=30000
AUTOMATION_SCHEDULER_BATCH=1
MEMORY_SCHEDULER_INTERVAL_MS=60000
WORKER_MAINTENANCE_LIMIT=50
# Required for the built-in foreground DeepSeek chat models.
DEEPSEEK_API_KEY=
# Required for Qwen background tasks, vision, OCR, PDF parsing, and dreaming.
OPENROUTER_API_KEY=
CHAT_DURABLE_SUMMARIES_ENABLED=false
PDF_OCR_CONCURRENCY=2
PDF_IMAGE_ANALYSIS_CONCURRENCY=2
# Private Compose-only OpenDataLoader hybrid backend. Do not publish this port.
OPENDATALOADER_HYBRID_URL=http://opendataloader-hybrid:5002
# Self-hosted search stack. These endpoints are private Compose services except
# for the explicit Wikipedia upstream configured by MEDIAWIKI_API_URL.
SEARCH_STACK_ENABLED=true
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-a-long-random-secret
REDLIB_URL=http://redlib:8080
REDLIB_PUBLIC_BASE_URL=https://www.reddit.com
MEDIAWIKI_API_URL=https://en.wikipedia.org/w/api.php
MINIFLUX_URL=http://miniflux:8080
MINIFLUX_API_TOKEN=
MINIFLUX_DB_PASSWORD=replace-with-a-long-random-password
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=replace-with-a-long-random-password
FIRECRAWL_URL=http://firecrawl:3002
# Self-hosted Firecrawl does not require an API key; set this only if local auth
# is enabled in the Firecrawl deployment.
FIRECRAWL_API_KEY=
FIRECRAWL_DB_PASSWORD=replace-with-a-long-random-password
FIRECRAWL_BULL_AUTH_KEY=replace-with-a-long-random-secret
FIRECRAWL_MAX_CONCURRENT_PAGES=1
FIRECRAWL_MAX_CONCURRENT_JOBS=1
FIRECRAWL_BROWSER_POOL_SIZE=1
# Deep Research model/evidence limits. Search and page retrieval are local.
DEEP_RESEARCH_MAX_SEARCHES=6
DEEP_RESEARCH_MAX_FETCHED_PAGES=10
DEEP_RESEARCH_MAX_FOLLOW_UP_SEARCHES=2
DEEP_RESEARCH_MAX_EVIDENCE_TOKENS=12000
DEEP_RESEARCH_MAX_MODEL_CALLS=4
DEEP_RESEARCH_MAX_ESTIMATED_COST_USD=0.10
DEEP_RESEARCH_MAX_PAGES_PER_DOMAIN=2
# Optional coarse server location advertised to the assistant. This is explicit deployment
# metadata only; it must not contain user location, an API URL, or provider credentials.
DEPLOYMENT_LOCATION=
# Private Compose-only local Python execution worker. Generate at least 32
# random characters for production; this secret is never exposed to Python
# subprocesses or published outside the Compose execution network.
PYTHON_WORKER_URL=http://python-worker:5003
PYTHON_WORKER_SECRET=
PYTHON_WORKSPACE_VOLUME_NAME=wowzerbowser-python-workspaces
PYTHON_EXECUTION_NETWORK_NAME=wowzerbowser-python-execution
ARTIFACT_SIGNING_SECRET=
# Base64 or hex encoding of exactly 32 random bytes. Used only server-side.
CUSTOM_TOOL_ENCRYPTION_KEY=
# Google Calendar OAuth web client. The redirect URI is
# ${NEXT_PUBLIC_SITE_URL}/api/integrations/google-calendar/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
# Base64 or hex encoding of exactly 32 random bytes.
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
# Base64 or hex encoding of exactly 32 random bytes. Connector credentials are server-only.
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=
# Managed connectors use Pipedream Connect through this server-only adapter.
PIPEDREAM_CONNECT_BASE_URL=https://api.pipedream.com/v1/connect
PIPEDREAM_CONNECT_API_KEY=
PIPEDREAM_CONNECT_CLIENT_ID=
PIPEDREAM_CONNECT_STATE_SECRET=
USER_MEMORY_DREAMING_ENABLED=true
# Optional private Discord DM integration. The Gateway worker is started with
# `docker compose --profile discord`; its internal API URL is fixed to the
# local Compose `web` service and is never the public Tailscale URL.
DISCORD_INTERNAL_SECRET=replace-with-at-least-32-random-characters
DISCORD_ALLOWED_USER_ID=
# Discord profile only. Do not expose this as a NEXT_PUBLIC variable.
DISCORD_BOT_TOKEN=
DISCORD_PROCESSING_INTERVAL_MS=1000
